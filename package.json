{
  "name": "overlap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@vinext/cloudflare": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-8c6014f9a",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "cf": "^1.0.0-beta.16",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "mkdir -p public/og && cp node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff public/og/",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply overlap --local --persist-to .cloudflare/state",
    "db:migrate:remote": "wrangler d1 migrations apply overlap --remote"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
